<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : rien de sensible ne part en sauvegarde cloud ni en transfert d'appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_store.xml" />
        <exclude domain="sharedpref" path="totp_vault.xml" />
        <exclude domain="sharedpref" path="hce_emulation.xml" />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_store.xml" />
        <exclude domain="sharedpref" path="totp_vault.xml" />
        <exclude domain="sharedpref" path="hce_emulation.xml" />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
