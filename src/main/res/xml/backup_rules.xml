<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde désactivée (allowBackup="false") ; ces exclusions restent une
     défense en profondeur si elle est réactivée : secrets et captures ne doivent
     jamais quitter l'appareil. -->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_store.xml" />
    <exclude domain="sharedpref" path="totp_vault.xml" />
    <exclude domain="sharedpref" path="hce_emulation.xml" />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
